# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_HMAC_SECRET: Secret key used for signing CSRF tokens and session metadata.
# In production, set a strong 64-character random hex secret.
SESSION_HMAC_SECRET="CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET"

# INITIAL_ADMIN_PASSWORD: Password used to securely provision the default Super Admin ('damwad') on first startup.
# The admin will be required to change this password upon first login.
INITIAL_ADMIN_PASSWORD=""
